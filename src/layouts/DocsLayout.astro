---
// Docs pages: the site's own header and footer (BaseLayout), with the docs
// sidebar in a sticky rail beside the page on wide screens. On phones a
// "Docs menu" bar under the header opens the same sidebar in a drawer. The
// search dialog is shared by every docs page.
//
// Page helpers, all progressive: code blocks get a copy button, headings a
// link to themselves, and a link to an anchor inside a closed tab opens it.
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsSearch from '../components/docs/DocsSearch.astro';
import Icon from '../components/Icon.astro';
import type { Props as HeadProps } from '../components/BaseHead.astro';
import '../styles/prose.css';

type Props = HeadProps & {
  /** The page's id ("user-guides/install"), or "section:<slug>" for a section page. */
  current?: string;
};
const { current, ...head } = Astro.props;
---

<BaseLayout {...head}>
  <slot name="head" slot="head" />

  <div class="docs-bar">
    <button type="button" data-docs-menu-open>
      <Icon name="menu" size={18} />
      Docs menu
    </button>
    <button type="button" class="bar-search" data-docs-search-open aria-label="Search docs">
      <Icon name="search" size={17} />
    </button>
  </div>

  <div class="docs-shell">
    <aside class="docs-rail" aria-label="Docs navigation">
      <DocsSidebar current={current} />
    </aside>
    <div class="docs-main">
      <slot />
    </div>
  </div>

  <dialog class="docs-drawer" aria-label="Docs menu" data-docs-menu>
    <form method="dialog" class="drawer-head">
      <span>Docs</span>
      <button aria-label="Close menu"><Icon name="close" size={20} /></button>
    </form>
    <DocsSidebar current={current} />
  </dialog>

  <DocsSearch />
</BaseLayout>

<style>
  .docs-shell {
    width: 100%;
    max-width: 92rem;
    margin-inline: auto;
  }

  .docs-rail {
    display: none;
  }

  .docs-main {
    min-width: 0;
    padding: var(--space-6) var(--gutter) var(--section);
  }

  .docs-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--gutter);
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .docs-bar button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0.5rem;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .docs-bar button:hover {
    color: var(--text);
  }

  @media (min-width: 64rem) {
    .docs-bar {
      display: none;
    }

    .docs-shell {
      display: grid;
      grid-template-columns: 17rem minmax(0, 1fr);
    }

    .docs-rail {
      position: sticky;
      top: var(--header-h);
      display: block;
      height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      border-right: 1px solid var(--border);
      scrollbar-width: thin;
    }

    .docs-main {
      padding: var(--space-7) clamp(1.5rem, 3vw, 3.5rem) var(--section);
    }
  }

  .docs-drawer {
    width: min(20rem, 88vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-right: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
  }

  .docs-drawer::backdrop {
    background: rgb(3 7 18 / 0.55);
    backdrop-filter: blur(2px);
  }

  .docs-drawer[open] {
    animation: drawer-in var(--dur-slow) var(--ease);
  }

  @keyframes drawer-in {
    from { transform: translateX(-100%); }
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--border);
    font-weight: 650;
  }

  .drawer-head button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--text-muted);
  }

  /* ---- Page helpers ---- */
  .docs-main :global(.copy) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--text-muted);
    font-size: var(--step--2);
    font-weight: 600;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .docs-main :global(.code-wrap) {
    position: relative;
  }

  .docs-main :global(.code-wrap:hover .copy),
  .docs-main :global(.copy:focus-visible),
  .docs-main :global(.copy.done) {
    opacity: 1;
  }

  .docs-main :global(.anchor) {
    margin-left: 0.4rem;
    color: var(--text-subtle);
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .docs-main :global(:is(h2, h3, h4):hover .anchor),
  .docs-main :global(.anchor:focus-visible) {
    opacity: 1;
  }
</style>

<script>
  // Phone menu
  const drawer = document.querySelector<HTMLDialogElement>('[data-docs-menu]');
  document.querySelector('[data-docs-menu-open]')?.addEventListener('click', () => drawer?.showModal());
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer || (e.target as HTMLElement).closest('a')) drawer.close();
  });

  const main = document.querySelector<HTMLElement>('.docs-main');
  if (main) {
    // Copy buttons on code blocks
    main.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.replaceWith(wrap);
      wrap.append(pre);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Press Ctrl+C';
        }
        button.classList.add('done');
        setTimeout(() => {
          button.textContent = 'Copy';
          button.classList.remove('done');
        }, 1600);
      });
      wrap.append(button);
    });

    // A link to each heading
    main.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]').forEach((h) => {
      const a = document.createElement('a');
      a.className = 'anchor';
      a.href = `#${h.id}`;
      a.setAttribute('aria-label', `Link to ${h.textContent}`);
      a.textContent = '#';
      h.append(a);
    });
  }

  // An anchor inside a closed tab: open the tab, then go there.
  const reveal = () => {
    const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const panel = target && target.closest<HTMLElement>('[data-tab][hidden]');
    if (!panel) return;
    const tabs = panel.parentElement!;
    tabs.querySelector<HTMLButtonElement>(`:scope > .tablist > button[data-value="${panel.dataset.tab}"]`)?.click();
    requestAnimationFrame(() => target.scrollIntoView());
  };
  window.addEventListener('hashchange', reveal);
  requestAnimationFrame(reveal);
</script>
