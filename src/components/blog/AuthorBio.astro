---
import { Image } from 'astro:assets';
import { author as findAuthor } from '../../lib/authors';

interface Props {
  name: string;
}
const author = findAuthor(Astro.props.name);
---

<section class="author" aria-label="About the author">
  <Image src={author.avatar} alt="" width={64} height={64} densities={[1, 2]} class="avatar" />
  <div>
    <h2 class="name">{author.name}</h2>
    <p class="bio">{author.bio}</p>
  </div>
</section>

<style>
  .author {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }

  .author :global(.avatar) {
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .name {
    font-size: var(--step-0);
    letter-spacing: 0;
  }

  .bio {
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
