---
// A YouTube video that loads nothing from YouTube until it is played: the
// poster is drawn here, and pressing play swaps in the privacy-enhanced
// (youtube-nocookie.com) player. Without JS it links to the video.
interface Props {
  videoId: string;
  title?: string;
}
const { videoId, title = 'YouTube video' } = Astro.props;
const valid = /^[a-zA-Z0-9_-]{11}$/.test(videoId);
const watch = `https://www.youtube.com/watch?v=${videoId}`;
---

{
  valid && (
    <figure class="yt" data-yt={videoId} data-title={title}>
      <a class="poster" href={watch} target="_blank" rel="noopener noreferrer">
        <span class="play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
        </span>
        <span class="label">
          <span class="name">Play video</span>
          <span class="note">Loads the player from YouTube</span>
        </span>
      </a>
    </figure>
  )
}

<style>
  .yt {
    position: relative;
    margin-block: var(--space-6);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 90% at 85% 10%, color-mix(in oklab, var(--accent) 30%, transparent), transparent 60%),
      radial-gradient(110% 100% at 10% 100%, color-mix(in oklab, var(--brand) 35%, transparent), transparent 60%),
      var(--gray-900);
  }

  .poster {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-3);
    color: #fff;
    text-decoration: none;
  }

  .play {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 10px 40px -8px color-mix(in oklab, var(--primary) 70%, transparent);
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .poster:hover .play {
    background: var(--success);
    transform: scale(1.05);
  }

  .label {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
  }

  .name {
    font-weight: 600;
  }

  .note {
    color: var(--gray-400);
    font-size: var(--step--2);
  }

  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((fig) => {
    fig.querySelector('a')?.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.yt}?autoplay=1`;
      frame.title = fig.dataset.title ?? 'YouTube video';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      fig.replaceChildren(frame);
    });
  });
</script>
