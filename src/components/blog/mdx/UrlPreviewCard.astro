---
// A link drawn as a card: the page's title, description, site and image.
// Blog posts and docs pages come from their collections; other pages from the previews saved
// at import (src/data/link-previews.json), so nothing is fetched at build
// time. A page without a saved preview shows as a plain card.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import previews from '../../../data/link-previews.json';
import Icon from '../../Icon.astro';
import { BLOG_TITLE } from '../../../lib/blog';
import { DOCS_TITLE } from '../../../lib/docs';

interface Props {
  url: string;
}
const { url } = Astro.props;

type Preview = { title: string; description?: string; site?: string; image?: ImageMetadata; host: string };
const images = import.meta.glob<{ default: ImageMetadata }>('../../../assets/link-previews/*', { eager: true });
const imageNamed = (name?: string) => (name ? Object.entries(images).find(([p]) => p.endsWith(`/${name}`))?.[1].default : undefined);

let card: Preview;
const internal = url.match(/^\/blog\/([a-z0-9_-]+)$/);
const docPage = url.match(/^\/docs(?:\/([a-z0-9/_-]+))?$/);
if (internal) {
  const post = await getEntry('blog', internal[1]);
  if (!post) throw new Error(`UrlPreviewCard: no post ${url}`);
  card = { title: post.data.title, description: post.data.description, site: BLOG_TITLE, image: post.data.thumbnail, host: `basicswapdex.com${url}` };
} else if (docPage) {
  const doc = await getEntry('docs', docPage[1] ?? 'intro');
  if (!doc) throw new Error(`UrlPreviewCard: no docs page ${url}`);
  card = { title: doc.data.title, description: doc.data.description, site: DOCS_TITLE, host: `basicswapdex.com${url}` };
} else {
  const saved = (previews as Record<string, { title: string; description?: string; site?: string; image?: string }>)[url];
  const host = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
  card = saved ? { ...saved, image: imageNamed(saved.image), host } : { title: host, host };
}
const external = !internal && !docPage;
---

<a class="preview" href={url} {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
  {
    card.image && (
      <span class="thumb">
        <Image src={card.image} alt="" width={360} />
      </span>
    )
  }
  <span class="text">
    {card.site && <span class="site">{card.site}</span>}
    <span class="title">{card.title}</span>
    {card.description && <span class="desc">{card.description}</span>}
    <span class="host data">
      {card.host}
      {external && <Icon name="external" size={12} />}
    </span>
  </span>
</a>

<style>
  .preview {
    display: flex;
    align-items: stretch;
    gap: var(--space-4);
    margin-block: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .preview:hover {
    border-color: color-mix(in oklab, var(--primary) 55%, var(--border));
    background: color-mix(in oklab, var(--primary) 5%, var(--surface));
  }

  .thumb {
    flex: none;
    width: 9.5rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    display: grid;
    align-content: center;
    gap: 0.2rem;
    min-width: 0;
    padding-block: var(--space-1);
  }

  .site {
    color: var(--text-subtle);
    font-size: var(--step--2);
    font-weight: 600;
  }

  .title {
    color: var(--text);
    font-weight: 600;
    line-height: 1.35;
  }

  .preview:hover .title {
    color: var(--link);
  }

  .desc {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.5;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .host {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    overflow: hidden;
    color: var(--text-subtle);
    font-size: var(--step--2);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .thumb {
      width: 6rem;
    }
  }
</style>
