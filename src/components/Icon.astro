export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 18, label, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={ICONS[name].vb}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={ICONS[name].body}
/>
