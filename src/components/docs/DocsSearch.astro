---
// Docs search: a dialog opened by any [data-docs-search-open] button, by
// Ctrl/Cmd+K or by "/". The index (/docs/search-index.json, built from the
// pages) loads the first time it opens; results point at the matching
// section of a page, with the matched words marked in a snippet. Arrow keys
// move through results and Enter opens one.
---

<dialog class="docs-search" aria-label="Search docs" data-docs-search>
  <div class="box">
    <label class="field">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></g></svg>
      <span class="visually-hidden">Search docs</span>
      <input type="search" placeholder="Search docs..." autocomplete="off" spellcheck="false" data-q />
      <kbd class="data">Esc</kbd>
    </label>
    <ul class="results" role="listbox" data-results></ul>
    <p class="status muted" data-status hidden></p>
  </div>
</dialog>

<style>
  .docs-search {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 4rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 30px 80px -20px hsl(var(--shadow-color) / 0.8);
  }

  .docs-search::backdrop {
    background: rgb(3 7 18 / 0.6);
    backdrop-filter: blur(3px);
  }

  .box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--border);
    color: var(--text-subtle);
  }

  input {
    flex: 1;
    min-width: 0;
    height: 3.5rem;
    border: 0;
    background: none;
    color: var(--text);
    font-size: var(--step-0);
    outline: none;
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  kbd {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-subtle);
    font-size: 0.7rem;
  }

  .results {
    margin: 0;
    padding: var(--space-2);
    overflow-y: auto;
    list-style: none;
  }

  .results:empty {
    display: none;
  }

  .results :global(a) {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
  }

  .results :global(a[aria-selected='true']) {
    background: color-mix(in oklab, var(--primary) 14%, transparent);
  }

  .results :global(.where) {
    color: var(--text-subtle);
    font-size: var(--step--2);
    font-weight: 600;
  }

  .results :global(.what) {
    font-weight: 600;
  }

  .results :global(.snippet) {
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--step--1);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .results :global(mark) {
    border-radius: 2px;
    background: color-mix(in oklab, var(--primary) 35%, transparent);
    color: var(--text);
  }

  .status {
    padding: var(--space-6) var(--space-4);
    font-size: var(--step--1);
    text-align: center;
  }
</style>

<script>
  type Entry = { page: string; section: string; heading?: string; href: string; text: string };

  const dialog = document.querySelector<HTMLDialogElement>('[data-docs-search]');
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('[data-q]')!;
    const list = dialog.querySelector<HTMLUListElement>('[data-results]')!;
    const status = dialog.querySelector<HTMLElement>('[data-status]')!;
    let index: Entry[] | null = null;
    let loading: Promise<void> | null = null;
    let selected = 0;

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const mark = (s: string, terms: string[]) =>
      terms.length ? esc(s).replace(new RegExp(`(${terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi'), '<mark>$1</mark>') : esc(s);

    const load = () =>
      (loading ??= fetch('/docs/search-index.json')
        .then((r) => r.json())
        .then((data: Entry[]) => {
          index = data;
        })
        .catch(() => {
          status.textContent = 'Search is unavailable right now.';
          status.hidden = false;
        }));

    function snippet(text: string, terms: string[]) {
      const lower = text.toLowerCase();
      const at = Math.min(...terms.map((t) => lower.indexOf(t)).filter((i) => i >= 0));
      const start = Number.isFinite(at) ? Math.max(0, at - 40) : 0;
      return (start > 0 ? '…' : '') + text.slice(start, start + 160);
    }

    function search(q: string) {
      if (!index) return [];
      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      if (!terms.length) {
        // no query: one entry per page, in reading order
        return index.filter((e) => !e.heading).map((e) => ({ e, score: 0, terms }));
      }
      return index
        .map((e) => {
          const page = e.page.toLowerCase();
          const heading = (e.heading ?? '').toLowerCase();
          const text = e.text.toLowerCase();
          let score = 0;
          for (const t of terms) {
            const inPage = page.includes(t);
            const inHeading = heading.includes(t);
            const hits = text.split(t).length - 1;
            if (!inPage && !inHeading && !hits) return { e, score: 0, terms };
            score += (inHeading ? 8 : 0) + (inPage ? (e.heading ? 2 : 10) : 0) + Math.min(hits, 5);
          }
          return { e, score, terms };
        })
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 12);
    }

    function render() {
      const results = search(input.value);
      selected = 0;
      list.innerHTML = results
        .map(
          ({ e, terms }, i) => `<li><a href="${e.href}" role="option" aria-selected="${i === 0}">
            <span class="where">${esc(e.section)}${e.heading ? ` · ${esc(e.page)}` : ''}</span>
            <span class="what">${mark(e.heading ?? e.page, terms)}</span>
            ${terms.length ? `<span class="snippet">${mark(snippet(e.text, terms), terms)}</span>` : ''}
          </a></li>`,
        )
        .join('');
      status.hidden = results.length > 0 || !index;
      status.textContent = `No results for "${input.value}".`;
    }

    function move(by: number) {
      const links = [...list.querySelectorAll('a')];
      if (!links.length) return;
      selected = (selected + by + links.length) % links.length;
      links.forEach((a, i) => a.setAttribute('aria-selected', String(i === selected)));
      links[selected].scrollIntoView({ block: 'nearest' });
    }

    async function open() {
      if (dialog!.open) return;
      document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d.close());
      dialog!.showModal();
      input.select();
      await load();
      render();
    }

    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-docs-search-open]')) open();
    });
    document.addEventListener('keydown', (e) => {
      const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
        e.preventDefault();
        open();
      }
    });
    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        move(e.key === 'ArrowDown' ? 1 : -1);
      } else if (e.key === 'Enter') {
        const a = list.querySelectorAll('a')[selected];
        if (a) {
          e.preventDefault();
          a.click();
        }
      }
    });
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) dialog!.close();
    });
    dialog.addEventListener('click', (e) => e.target === dialog && dialog!.close());

    // The shortcut hint matches the platform.
    if (/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('[data-kbd]').forEach((k) => (k.textContent = '⌘ K'));
  }
</script>
