---
// The Donations hero's backdrop, "Zero": a large 0% (no protocol fees) drawn
// as six stacked outline strokes in the ribbons' blue-to-violet, with a light
// passing over it. It sits right of the copy and fades in from the left.
// Still for reduced motion.
//
// Drawn on a 1600 x 900 canvas, placed in a frame the shape of the hero
// (1600 x 640): centred in the space right of the copy, scaled to its height.
const VB_H = 640;
const FIT_S = Math.min(1, VB_H / 900);
const FIT = { x: 1270 - 1150 * FIT_S, y: VB_H / 2 - 450 * FIT_S, width: 1600 * FIT_S, height: 900 * FIT_S, viewBox: '0 0 1600 900', overflow: 'visible' };
---

<div class="don-bd" aria-hidden="true">
  <svg viewBox={`0 0 1600 ${VB_H}`} preserveAspectRatio="xMidYMid slice">
    <svg {...FIT}>
      <defs>
        <linearGradient id="dn-zero" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#0073ff" />
          <stop offset="1" stop-color="#a855f7" />
        </linearGradient>
        <linearGradient id="dn-shine" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#fff" stop-opacity="0" />
          <stop offset="0.5" stop-color="#fff" stop-opacity="0.8" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <clipPath id="dn-zero-clip">
          <text x="1140" y="640" text-anchor="middle" class="d4-text">0%</text>
        </clipPath>
      </defs>
      {[0, 1, 2, 3, 4, 5].map((k) => (
        <text x={1140 + k * 4} y={640 + k * 4} text-anchor="middle" class="d4-text d4-line" stroke="url(#dn-zero)" stroke-opacity={0.75 - k * 0.11}>0%</text>
      ))}
      <g clip-path="url(#dn-zero-clip)">
        <rect x="0" y="200" width="260" height="520" fill="url(#dn-shine)" class="d4-shine" />
      </g>
    </svg>
  </svg>
</div>

<style>
  .don-bd {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* the copy sits on the left: the art fades in from there */
    -webkit-mask-image: linear-gradient(to right, rgb(0 0 0 / 0.28) 0%, rgb(0 0 0 / 0.55) 35%, black 70%);
    mask-image: linear-gradient(to right, rgb(0 0 0 / 0.28) 0%, rgb(0 0 0 / 0.55) 35%, black 70%);
  }

  .don-bd > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .d4-text {
    font: 700 520px var(--font-sans);
    letter-spacing: -0.04em;
  }

  .d4-line {
    fill: none;
    stroke-width: 1.2;
  }

  .d4-shine {
    animation: dn-shine 7s ease-in-out infinite;
  }

  @keyframes dn-shine {
    0% { translate: 500px 0; }
    60%, 100% { translate: 1700px 0; }
  }

  /* phones: the copy spans the width, so the art stays in the background */
  @media (max-width: 40rem) {
    .don-bd {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d4-shine {
      animation-play-state: paused;
    }
  }
</style>
