---
// The Protocol hero's backdrop, "Flow": encrypted messages streaming through
// the network with no centre and no operator. Fine flow lines cross the whole
// hero in three depths (far ones thin, dim and slow; near ones brighter and
// quicker), and along them messages travel as comets, a bright head trailing
// a fading tail. It fades in from the left, where the copy sits. Still for
// reduced motion.
//
// Kept light to draw: the still lines are one SVG that never changes, and the
// comets are drawn into a canvas over it (src/scripts/flow-comets.ts), each
// frame only their short segments. Without JS the lines show, still.
let seed = 41;
const rand = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
const r1 = (n: number) => Math.round(n * 10) / 10;

const W = 1800;
const H = 920;

// A gentle field that runs left to right, curling a little.
const angle = (x: number, y: number) => 0.13 * Math.sin(y * 0.011 + x * 0.0026) + 0.09 * Math.cos(x * 0.0049 - y * 0.004);
const stream = (y0: number) => {
  let x = -80;
  let y = y0;
  const pts: [number, number][] = [[x, y]];
  while (x < W + 80) {
    const a = angle(x, y);
    x += Math.cos(a) * 16;
    y += Math.sin(a) * 16;
    pts.push([x, y]);
  }
  return pts.map(([px, py]) => `${Math.round(px)},${Math.round(py)}`).join(' ');
};

// Three depths; each line spread evenly down the hero, with a little jitter.
const DEPTHS = [
  { k: 'far', n: 38, w: 0.7, bed: 0.1, comet: 0.45, dur: [16, 26], tail: 50 },
  { k: 'mid', n: 26, w: 1.1, bed: 0.16, comet: 0.7, dur: [10, 16], tail: 70 },
  { k: 'near', n: 14, w: 1.6, bed: 0.22, comet: 1, dur: [6, 10], tail: 95 },
];
const layers = DEPTHS.map((d) => ({
  ...d,
  lines: Array.from({ length: d.n }, (_, i) => {
    const y = -40 + ((i + 0.2 + rand() * 0.6) / d.n) * (H + 80);
    const comets = rand() < 0.8 ? (rand() < 0.35 ? 2 : 1) : 0;
    return {
      points: stream(y),
      comets: Array.from({ length: comets }, (_, c) => ({
        dur: r1(d.dur[0] + rand() * (d.dur[1] - d.dur[0])),
        delay: -r1(rand() * d.dur[1] + c * 5),
      })),
    };
  }),
}));
---

<div class="proto-bd" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="pf-line" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#0073ff" />
        <stop offset="0.6" stop-color="#3b82f6" />
        <stop offset="1" stop-color="#a855f7" />
      </linearGradient>
      <radialGradient id="pf-glow" cx="0.78" cy="0.45" r="0.6">
        <stop offset="0" stop-color="#0073ff" stop-opacity="0.2" />
        <stop offset="0.5" stop-color="#a855f7" stop-opacity="0.06" />
        <stop offset="1" stop-color="#0073ff" stop-opacity="0" />
      </radialGradient>
      <pattern id="pf-dots" width="28" height="28" patternUnits="userSpaceOnUse">
        <circle cx="14" cy="14" r="1" fill="#60a5fa" fill-opacity="0.12" />
      </pattern>
    </defs>

    <rect width={W} height={H} fill="url(#pf-glow)" />
    <rect width={W} height={H} fill="url(#pf-dots)" />
    {
      layers.map(({ w, bed, comet, tail, lines }) =>
        lines.map(({ points, comets }) => (
          <polyline
            points={points}
            class="bed"
            stroke-width={w}
            stroke-opacity={bed}
            data-comets={comets.map(({ dur, delay }) => `${dur},${delay}`).join(';')}
            data-w={w}
            data-op={comet}
            data-tail={tail / 1000}
          />
        )),
      )
    }
  </svg>

  {/* the comets, drawn by script */}
  <canvas class="comets" data-w={W} data-h={H}></canvas>
</div>

<style>
  .proto-bd {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask-image:
      linear-gradient(to right, rgb(0 0 0 / 0.08) 0%, rgb(0 0 0 / 0.25) 30%, rgb(0 0 0 / 0.65) 55%, black 82%),
      linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, rgb(0 0 0 / 0.08) 0%, rgb(0 0 0 / 0.25) 30%, rgb(0 0 0 / 0.65) 55%, black 82%),
      linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);
    mask-composite: intersect;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bed {
    fill: none;
    stroke-linejoin: round;
    stroke: url(#pf-line);
  }

  .comets {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 40rem) {
    .proto-bd {
      opacity: 0.5;
    }
  }

</style>

<script>
  import '../../scripts/flow-comets';
</script>
