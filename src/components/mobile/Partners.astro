---
// The apps building BasicSwap in, each with its app icon: Nexus, the first,
// as a wide feature with a BasicSwap x Nexus lockup (the two app icons
// over Nexus's glass button row, Swap lit), and the coming-soon apps in a row
// beneath it. Edge's logo isn't in the repo yet, so its name stands in.
import { getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import nexusIcon from '../../assets/partners/nexus.png';
import cakeIcon from '../../assets/partners/cake.png';
import particlIcon from '../../assets/partners/particl.svg';

const nexus = await getImage({ src: nexusIcon, format: 'webp', width: 192, quality: 90 });
const cake = await getImage({ src: cakeIcon, format: 'webp', width: 192, quality: 90 });

type Partner = {
  k: string;
  name: string;
  kind: string;
  live: boolean;
  body: string;
  href?: string;
  site?: string;
  logo?: string;
  tile: string; // the icon's backing, as on its app icon
  tint: string; // brand colour for glows and edges
  pad?: string; // inset of a mark that isn't full-bleed
  hidden?: boolean; // kept here, left off the page for now
};

const partners: Partner[] = [
  {
    k: 'nexus',
    name: 'Litecoin Nexus Wallet',
    kind: 'Wallet integration',
    live: false,
    body: "The first wallet to build BasicSwap in. Once it ships, you'll find it under Swap on the wallet's home screen, next to Send and Receive.",
    href: 'https://nexuswallet.com/',
    site: 'Visit Nexus Wallet',
    logo: nexus.src,
    tile: '#1162E6',
    tint: '#2f7bff',
  },
  {
    k: 'cake',
    name: 'Cake Wallet',
    kind: 'Wallet integration',
    live: false,
    body: 'The open-source wallet for Monero, Bitcoin and Litecoin, adding built-in swaps between them.',
    href: 'https://cakewallet.com',
    site: 'Visit Cake Wallet',
    logo: cake.src,
    tile: '#ffffff',
    tint: '#ff7a1a',
    pad: '14%',
  },
  {
    k: 'edge',
    name: 'Edge Wallet',
    kind: 'Wallet integration',
    live: false,
    body: 'A self-custody wallet for Bitcoin, Monero and more, adding swaps across chains.',
    href: 'https://edge.app',
    site: 'Visit Edge',
    hidden: true,
    tile: '#0d2b3e',
    tint: '#40c7a0',
  },
  {
    k: 'particl',
    name: 'Particl Marketplace v2',
    kind: 'dApp integration',
    live: false,
    body: "Particl's private marketplace will use BasicSwap so people can pay with the coins they already hold.",
    href: 'https://particl.io',
    site: 'Visit Particl',
    logo: particlIcon.src,
    tile: '#11161d',
    tint: '#46d593',
    pad: '20%',
  },
];

const [lead, ...soon] = partners.filter((p) => !p.hidden);
const status = (p: Partner) => (p.live ? 'live in beta' : 'coming soon');
---

<div class="partners">
  <a class="lead" href={lead.href} target="_blank" rel="noopener noreferrer" style={`--tint:${lead.tint}`}>
    <div class="lead-copy">
      <p class="kind">{lead.kind} <span class:list={['status', { live: lead.live }]} data-parity="new">{status(lead)}</span></p>
      <h3>{lead.name}</h3>
      <p class="body" data-parity="new">{lead.body}</p>
      <p class="visit" data-parity="new">{lead.site} <Icon name="external" size={13} /></p>
    </div>
    <div class="lockup" aria-hidden="true" data-parity="new">
      <div class="pair">
        <span class="icon app bsx-app"><svg viewBox="3 2 20 28" width="46" height="46"><path fill="#fff" d="M5.4,10.6C5.4,9.1,6.6,8,8,8h11.8l-2,2c-0.3,0.3-0.3,0.9,0,1.2s0.9,0.3,1.2,0l3.4-3.4c0.2-0.1,0.3-0.4,0.3-0.7c0-0.2-0.1-0.5-0.3-0.6L19,3c-0.3-0.3-0.9-0.3-1.2,0c-0.3,0.3-0.3,0.9,0,1.2l2,2H8c-2.4,0-4.3,2-4.3,4.4v8.1c0,0.5,0.4,0.9,0.9,0.9s0.9-0.4,0.9-0.9L5.4,10.6L5.4,10.6z M18.1,24H6.3l2-2c0.3-0.3,0.3-0.9,0-1.2c-0.3-0.3-0.9-0.3-1.2,0l-3.4,3.4c-0.2,0.1-0.3,0.4-0.3,0.7c0,0.2,0.1,0.5,0.3,0.6L7.1,29c0.3,0.3,0.9,0.3,1.2,0s0.3-0.9,0-1.2l-2-2h11.8c2.4,0,4.3-2,4.3-4.4v-8.1c0-0.5-0.4-0.9-0.9-0.9s-0.9,0.4-0.9,0.9v8.1C20.7,22.9,19.5,24,18.1,24z"/></svg></span>
        <svg class="times" viewBox="0 0 16 16" width="16" height="16"><path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span class="icon app" style={`--tile:${lead.tile}`}><img src={lead.logo} alt="" width="96" height="96" /></span>
      </div>
    </div>
  </a>
  <ul class="soon" role="list" style={`--n:${soon.length}`}>
    {
      soon.map((p) => (
        <li style={`--tint:${p.tint}`} data-parity={p.k === 'particl' ? undefined : 'new'}>
          <a href={p.href} target="_blank" rel="noopener noreferrer">
            <span class="icon" style={`--tile:${p.tile};--pad:${p.pad ?? '0'}`}>
              {p.logo ? <img src={p.logo} alt="" width="56" height="56" /> : <b>{p.k}</b>}
            </span>
            <p class="kind">{p.kind} <span class="status">{status(p)}</span></p>
            <h3>{p.name}</h3>
            <p class="body" data-parity="new">{p.body}</p>
            <p class="visit">{p.site} <Icon name="external" size={13} /></p>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  ul,
  ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* ---- shared pieces ---- */
  .icon {
    --size: 3.5rem;
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--size);
    height: var(--size);
    overflow: hidden;
    border-radius: 24%;
    background: var(--tile);
    box-shadow:
      0 0 0 1px color-mix(in oklab, white 10%, transparent) inset,
      0 1px 0 color-mix(in oklab, white 18%, transparent) inset,
      0 12px 24px -10px hsl(var(--shadow-color) / 0.7);
  }

  .icon img {
    width: calc(100% - 2 * var(--pad, 0%));
    height: auto;
  }

  .icon b {
    color: color-mix(in oklab, var(--tint) 85%, white);
    font-size: calc(var(--size) * 0.27);
    font-weight: 700;
    letter-spacing: -0.01em;
  }


  .kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--text-subtle);
    font-size: var(--step--1);
  }

  h3 {
    font-size: var(--step-2);
    letter-spacing: var(--tracking-tight);
  }

  .body {
    color: var(--text-muted);
  }

  .status {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: var(--step--2);
    white-space: nowrap;
  }

  .status.live {
    border-color: color-mix(in oklab, var(--success) 45%, transparent);
    background: color-mix(in oklab, var(--success) 10%, transparent);
    color: var(--success);
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--link);
    font-weight: 600;
  }

  /* ---- the layout ---- */
  .partners {
    display: grid;
    gap: var(--space-5);
  }

  .lead {
    position: relative;
    display: grid;
    gap: var(--space-6);
    overflow: hidden;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border: 1px solid color-mix(in oklab, var(--tint) 35%, var(--border));
    border-radius: 1.25rem;
    background:
      radial-gradient(60% 120% at 100% 50%, color-mix(in oklab, var(--tint) 22%, transparent), transparent 70%),
      linear-gradient(160deg, color-mix(in oklab, var(--bg) 80%, var(--tint)), var(--bg) 60%);
    box-shadow: 0 30px 60px -30px hsl(var(--shadow-color) / 0.8);
  }

  .lead {
    transition: border-color var(--dur) var(--ease);
  }

  .lead:hover {
    border-color: color-mix(in oklab, var(--tint) 70%, var(--border));
  }

  .lead-copy {
    display: grid;
    align-content: center;
    gap: var(--space-3);
    max-width: 34rem;
  }

  .lead-copy h3 {
    font-size: var(--step-3);
  }

  /* BasicSwap x Nexus: the two app icons, centred on a spotlight with
     faint rings. */
  .lockup {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 10rem;
    isolation: isolate;
  }

  .lockup::before {
    content: '';
    position: absolute;
    inset: -30% -10%;
    z-index: -1;
    background:
      radial-gradient(closest-side, color-mix(in oklab, var(--tint) 30%, transparent), transparent 75%),
      repeating-radial-gradient(circle, transparent 0 46px, color-mix(in oklab, var(--tint) 22%, transparent) 46px 47px);
    mask: radial-gradient(closest-side, black 30%, transparent 85%);
    pointer-events: none;
  }

  .pair {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .app {
    --size: 5.5rem;
    box-shadow:
      0 0 0 1px color-mix(in oklab, white 14%, transparent) inset,
      0 1px 0 color-mix(in oklab, white 30%, transparent) inset,
      0 -10px 20px -12px rgb(0 0 0 / 0.35) inset,
      0 24px 40px -18px color-mix(in oklab, var(--tile, var(--brand)) 80%, black),
      0 2px 6px rgb(0 0 0 / 0.25);
  }

  .bsx-app {
    --tile: #0073ff;
    background: linear-gradient(160deg, #3d93ff, #0073ff 45%, #0056cc);
  }

  .times {
    color: var(--text-subtle);
  }


  .soon {
    display: grid;
    gap: var(--space-5);
  }

  .soon a {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: linear-gradient(to bottom, color-mix(in oklab, var(--surface) 60%, var(--bg)), var(--bg));
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .soon a:hover {
    border-color: color-mix(in oklab, var(--tint) 55%, var(--border));
    box-shadow: 0 20px 40px -24px color-mix(in oklab, var(--tint) 60%, transparent);
  }

  .soon .icon {
    margin-bottom: var(--space-2);
  }

  .soon h3 {
    font-size: var(--step-1);
  }

  .soon .body {
    font-size: var(--step--1);
  }

  .soon .visit {
    margin-top: auto;
    font-size: var(--step--1);
  }

  @media (min-width: 52rem) {
    .lead {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
    }

    /* one column per app, so the row stays full as apps come and go */
    .soon {
      grid-template-columns: repeat(var(--n), 1fr);
    }
  }

</style>
