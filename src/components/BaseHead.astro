---
import { Font } from 'astro:assets';
import { SITE_NAME, SITE_URL } from '../config/site';
import SiteScript from './SiteScript.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** og/twitter description, when it differs from the meta description. */
  socialDescription?: string;
  /** Page path, e.g. "/faq". Builds the canonical and og:url. */
  path: string;
  ogType?: 'website' | 'article';
  /** Site-relative path to the share image, 1200x630 unless sized below. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageSize?: { width: number; height: number };
  /** Articles: dates (ISO 8601), section, tags and author, each when known. */
  article?: { published?: string; modified?: string; section?: string; tags?: string[]; author?: string };
  /** JSON-LD objects, each emitted as its own script block. */
  jsonLd?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  socialDescription = description,
  path,
  ogType = 'website',
  ogImage = '/site-meta.png',
  ogImageAlt = SITE_NAME,
  ogImageSize = { width: 1200, height: 630 },
  article,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = `${SITE_URL}${path === '/' ? '/' : path}`;
const image = `${SITE_URL}${ogImage}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<SiteScript />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#111827" />

<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />

<link rel="icon" sizes="32x32" type="image/png" href="/images/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={socialDescription} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(ogImageSize.width)} />
<meta property="og:image:height" content={String(ogImageSize.height)} />
<meta property="og:image:alt" content={ogImageAlt} />

{
  article && [
    article.published && <meta property="article:published_time" content={article.published} />,
    article.modified && <meta property="article:modified_time" content={article.modified} />,
    article.author && <meta property="article:author" content={article.author} />,
    article.section && <meta property="article:section" content={article.section} />,
    ...(article.tags ?? []).map((tag) => <meta property="article:tag" content={tag} />),
  ]
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@BasicSwapDEX" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={socialDescription} />
<meta name="twitter:image" content={image} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
