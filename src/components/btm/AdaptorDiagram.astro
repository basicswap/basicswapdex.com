---
// "How claiming the Bitcoin hands over the Monero key", played as a short
// loop in the film's colours: your half of the Monero key is gold, the
// seller's is orange.
//   1. Your pre-given Bitcoin signature waits on one missing piece.
//   2. The seller's half completes it, and the Bitcoin is claimed.
//   3. Claiming publishes that half: it drops down to the Monero side.
//   4. It joins your half, and the Monero spend key opens.
// One 10 s loop (film.ts), started once the diagram comes into view and paused
// off screen. Without JS, and with reduced motion, it holds on the open key.
import { Image } from 'astro:assets';
import { Film } from '../desktop/film';
import bitcoin from '../../assets/coins/bitcoin-circle.png';
import monero from '../../assets/coins/monero-circle.png';

const D = 10;
const film = new Film('.ad', D, 0, D, [{ when: '.adaptor.playing', delay: 0, suffix: '' }]);
const pop = (name: string, sel: string, t: number) =>
  film.track(name, sel, [[0, 'opacity:0;scale:0.6'], [t - 0.05, 'opacity:0;scale:0.6'], [t + 0.25, 'opacity:1;scale:1.12'], [t + 0.45, 'opacity:1;scale:1'], [9.4, 'opacity:1;scale:1'], [9.8, 'opacity:0;scale:1']], 'ease-out');
const swapText = (name: string, a: string, b: string, t: number) =>
  film.show(`${name}-a`, a, [[0, t]], 0.15).show(`${name}-b`, b, [[t, 9.6]], 0.15);

// 1-2. the missing piece is filled, the Bitcoin is claimed
film.show('ask', '.ask', [[0, 1.2]], 0.15);
pop('fill-btc', '.slot-btc .half', 1.2);
swapText('btc-state', '.btc .state-a', '.btc .state-b', 1.7);
film.track('btc-glow', '.btc', [[0, '--lit:0'], [1.6, '--lit:0'], [1.9, '--lit:1'], [3.2, '--lit:1'], [3.8, '--lit:0']], 'ease-out');

// 3. the published half travels down the wire
film
  .track('drop', '.drop', [[0, 'opacity:0;translate:-50% 0%'], [2.0, 'opacity:0;translate:-50% 0%'], [2.2, 'opacity:1;translate:-50% 10%'], [3.3, 'opacity:1;translate:-50% 330%'], [3.5, 'opacity:0;translate:-50% 360%']], 'cubic-bezier(0.5, 0, 0.3, 1)')
  .track('wire', '.wire-line i', [[0, 'scale:1 0'], [2.0, 'scale:1 0'], [3.4, 'scale:1 1'], [9.4, 'scale:1 1'], [9.8, 'scale:1 0']], 'cubic-bezier(0.5, 0, 0.3, 1)')
  .show('wire-note', '.wire-note b', [[2.0, 9.6]], 0.3);

// 4. it joins your half, and the key opens
film.show('empty', '.slot-xmr .empty', [[0, 3.5]], 0.15);
pop('fill-xmr', '.slot-xmr .half', 3.5);
film.track('join', '.halves', [[0, 'gap:0.75rem'], [4.0, 'gap:0.75rem'], [4.4, 'gap:0.15rem'], [9.4, 'gap:0.15rem'], [9.8, 'gap:0.75rem']], 'cubic-bezier(0.3, 1.4, 0.5, 1)');
swapText('xmr-state', '.xmr .state-a', '.xmr .state-b', 4.4);
film.track('xmr-glow', '.xmr', [[0, '--lit:0'], [4.3, '--lit:0'], [4.7, '--lit:1'], [9.2, '--lit:1'], [9.7, '--lit:0']], 'ease-out');
film.track('foot', '.foot', [[0, 'opacity:0.45'], [4.4, 'opacity:0.45'], [4.8, 'opacity:1'], [9.4, 'opacity:1'], [9.8, 'opacity:0.45']], 'linear');

const css = film.css();
const KEY = '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-3 3 2 2m-4 0 2 2"/></g>';
const LOCK = '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/></g>';
const OPEN = '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 6.8-1.2"/></g>';
---

<figure class="adaptor">
  <div class="ad" role="img" aria-label="How claiming the Bitcoin hands over the Monero key. Your Bitcoin signature, given in advance, is missing one piece: the seller's half of the Monero key. The seller adds it to claim the Bitcoin, which publishes that half on chain. It joins the half you held all along, and the Monero spend key opens. There is no script on the Monero side.">
    <div class="card btc" aria-hidden="true">
      <div class="top">
        <span class="coin"><Image src={bitcoin} alt="" width={64} height={64} /></span>
        <span class="kick">bitcoin · locked 2 of 2</span>
        <span class="state"><span class="state-a">waiting</span><span class="state-b">claimed</span></span>
      </div>
      <p class="title">Your signature, given in advance</p>
      <p class="body">It only works with the seller's half of the Monero key.</p>
      <div class="formula">
        <span class="chip sig">sig</span>
        <span class="op">+</span>
        <span class="slot slot-btc"><span class="ask">?</span><span class="half theirs"><svg viewBox="0 0 24 24" set:html={KEY} />their half</span></span>
      </div>
    </div>

    <div class="wire" aria-hidden="true">
      <span class="wire-line"><i></i></span>
      <span class="drop half theirs"><svg viewBox="0 0 24 24" set:html={KEY} /></span>
      <p class="wire-note">The seller claims the Bitcoin, <b>which publishes their half</b></p>
    </div>

    <div class="card xmr" aria-hidden="true">
      <div class="top">
        <span class="coin"><Image src={monero} alt="" width={64} height={64} /></span>
        <span class="kick">monero · spend key</span>
        <span class="state"><span class="state-a"><svg viewBox="0 0 24 24" set:html={LOCK} />locked</span><span class="state-b"><svg viewBox="0 0 24 24" set:html={OPEN} />yours</span></span>
      </div>
      <p class="title">Their half, now public, plus yours</p>
      <p class="body">Together they make the whole key. Nobody else has your half.</p>
      <div class="formula halves">
        <span class="slot slot-xmr"><span class="empty">their half</span><span class="half theirs"><svg viewBox="0 0 24 24" set:html={KEY} />their half</span></span>
        <span class="op">+</span>
        <span class="half yours"><svg viewBox="0 0 24 24" set:html={KEY} />your half</span>
      </div>
    </div>

    <p class="foot" aria-hidden="true"><span class="dot"></span>No script on the Monero side</p>
  </div>
</figure>

<style is:inline set:html={css}></style>

<script>
  // Start the loop the first time the diagram is seen, and pause it off screen.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.adaptor').forEach((el) => {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !still.matches) el.classList.add('playing');
      el.classList.toggle('off', !entry.isIntersecting);
    }).observe(el);
    still.addEventListener('change', () => el.classList.toggle('playing', !still.matches));
  });
</script>

<style>
  @property --lit {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .adaptor {
    --btc: #f7b500;
    --xmr: #ff6600;
    width: 100%;
    max-width: 27rem;
  }

  .adaptor.off :global(*) {
    animation-play-state: paused !important;
  }

  .ad {
    display: grid;
  }

  /* ---- the two cards ---- */
  .card {
    --c: var(--btc);
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid color-mix(in oklab, var(--c) calc(var(--lit) * 45% + 12%), var(--border));
    border-radius: calc(var(--radius-xl) + 0.25rem);
    background:
      radial-gradient(80% 70% at 100% 0%, color-mix(in oklab, var(--c) calc(var(--lit) * 14% + 4%), transparent), transparent 70%),
      var(--surface);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 20px 50px -28px hsl(var(--shadow-color) / 0.8),
      0 0 50px -18px color-mix(in oklab, var(--c) calc(var(--lit) * 60%), transparent);
  }

  .card.xmr {
    --c: var(--xmr);
  }

  .top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .coin {
    display: grid;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    box-shadow: 0 0 18px -4px color-mix(in oklab, var(--c) 80%, transparent);
  }

  .coin :global(img) {
    width: 100%;
    height: 100%;
  }

  .kick {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .state {
    display: inline-grid;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .state > span {
    display: inline-flex;
    grid-area: 1 / 1;
    align-items: center;
    justify-self: end;
    gap: 0.3em;
    padding: 0.15em 0.65em;
    border-radius: var(--radius-full);
  }

  .state svg {
    width: 1.1em;
    height: 1.1em;
  }

  .state-a {
    background: color-mix(in oklab, var(--text) 8%, transparent);
    color: var(--text-muted);
    opacity: 0;
  }

  .state-b {
    background: color-mix(in oklab, var(--success) 16%, transparent);
    color: var(--success);
  }

  .title {
    color: var(--text);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .body {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  /* ---- the formulas: signature + half, half + half ---- */
  .formula {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-3);
  }

  .op {
    color: var(--text-subtle);
    font-family: var(--font-mono);
  }

  .chip,
  .half,
  .empty,
  .ask {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    height: 2.1rem;
    padding-inline: 0.8rem;
    border-radius: var(--radius-lg);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .chip {
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text);
  }

  .slot {
    display: inline-grid;
  }

  .slot > * {
    grid-area: 1 / 1;
  }

  .ask,
  .empty {
    justify-content: center;
    border: 1px dashed color-mix(in oklab, var(--xmr) 55%, var(--border-strong));
    color: color-mix(in oklab, var(--xmr) 70%, var(--text-muted));
    opacity: 0;
  }

  .empty {
    color: var(--text-subtle);
  }

  .half svg {
    width: 1.05em;
    height: 1.05em;
  }

  .half.theirs {
    border: 1px solid color-mix(in oklab, var(--xmr) 70%, transparent);
    background: color-mix(in oklab, var(--xmr) 16%, var(--bg));
    color: color-mix(in oklab, var(--xmr) 75%, var(--text));
    box-shadow: 0 0 22px -6px color-mix(in oklab, var(--xmr) 80%, transparent);
  }

  .half.yours {
    border: 1px solid color-mix(in oklab, var(--btc) 70%, transparent);
    background: color-mix(in oklab, var(--btc) 14%, var(--bg));
    color: color-mix(in oklab, var(--btc) 70%, var(--text));
    box-shadow: 0 0 22px -6px color-mix(in oklab, var(--btc) 70%, transparent);
  }

  .halves {
    gap: 0.15rem;
  }

  .halves .op {
    padding-inline: 0.6rem;
  }

  /* ---- the wire between the cards ---- */
  .wire {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: center;
    min-height: 5.5rem;
    padding-left: var(--space-5);
  }

  .wire-line {
    position: relative;
    justify-self: center;
    width: 2px;
    height: 100%;
    border-radius: 2px;
    background: color-mix(in oklab, var(--text) 10%, transparent);
  }

  .wire-line i {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(var(--btc), var(--xmr));
    transform-origin: top;
  }

  .drop {
    position: absolute;
    top: 0;
    left: calc(var(--space-5) + 1.25rem);
    width: 1.6rem;
    height: 1.6rem;
    padding: 0;
    justify-content: center;
    border-radius: var(--radius-full);
    opacity: 0;
  }

  .wire-note {
    padding-left: var(--space-3);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .wire-note b {
    color: color-mix(in oklab, var(--xmr) 70%, var(--text));
    font-weight: 600;
  }

  .foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--success);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--success);
    box-shadow: 0 0 10px var(--success);
  }
</style>
