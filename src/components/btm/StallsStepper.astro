---
// "When someone stops partway" on the Bitcoin to Monero page: a tab per
// case, and one panel with its three steps and what each trader ends up
// with. Cases about the seller stopping are orange, cases about you gold.
// Without JS every panel shows, one after another.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import bitcoin from '../../assets/coins/bitcoin-circle.png';
import monero from '../../assets/coins/monero-circle.png';

interface Stall {
  who: string;
  title: string;
  steps: string[];
  outcome: string;
  ends: { you: string; seller: string };
}
interface Props {
  stalls: Stall[];
}
const { stalls } = Astro.props;

const COIN: Record<string, { img: ImageMetadata; name: string }> = {
  btc: { img: bitcoin, name: 'Bitcoin' },
  xmr: { img: monero, name: 'Monero' },
};
---

<div class="stepper" data-case="0">
  <div class="tabs" role="tablist" aria-label="Cases">
    {
      stalls.map(({ who, title }, i) => (
        <button
          type="button"
          role="tab"
          id={`stall-tab-${i}`}
          aria-controls={`stall-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-i={i}
          class={`who-${who}`}>
          <span class="case-n data">case {i + 1}</span>
          {title}
        </button>
      ))
    }
  </div>
  {
    stalls.map(({ who, title, steps, outcome, ends }, i) => (
      <div class={`panel who-${who}`} role="tabpanel" id={`stall-panel-${i}`} aria-labelledby={`stall-tab-${i}`} data-i={i}>
        <h3>{title}</h3>
        <ol class="steps" role="list">
          {steps.map((step, j) => (
            <li>
              <span class="num data">0{j + 1}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>
        <div class="ends">
          <div class="end">
            <span class="end-who">You end up with</span>
            <span class="coin">
              <Image src={COIN[ends.you].img} alt="" width={64} height={64} />
              {COIN[ends.you].name}
            </span>
          </div>
          <div class="end">
            <span class="end-who">The seller ends up with</span>
            <span class="coin">
              <Image src={COIN[ends.seller].img} alt="" width={64} height={64} />
              {COIN[ends.seller].name}
            </span>
          </div>
          <p class="outcome">
            <Icon name="check" size={14} />
            {outcome}
          </p>
        </div>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('.stepper').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const show = (i: number, focus = false) => {
      root.dataset.case = String(i);
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      // arrow keys move between the tabs
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (step) show((i + step + tabs.length) % tabs.length, true);
      });
    });
  });
</script>

<style>
  .stepper {
    --btc: #f7b500;
    --xmr: #ff6600;
    display: grid;
    gap: var(--space-4);
  }

  .who-you {
    --c: var(--btc);
  }

  .who-seller {
    --c: var(--xmr);
  }

  .tabs {
    display: grid;
    gap: var(--space-2);
  }

  /* without JS the tabs do nothing, so they step aside for the panels */
  :global(html:not([data-js])) .tabs {
    display: none;
  }

  .tabs button {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--step-0);
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .tabs button:hover {
    color: var(--text);
  }

  .tabs button[aria-selected='true'] {
    border-color: color-mix(in oklab, var(--c) 60%, var(--border));
    background: color-mix(in oklab, var(--c) 8%, var(--surface));
    color: var(--text);
    box-shadow: inset 0 -3px 0 var(--c);
  }

  .case-n {
    color: color-mix(in oklab, var(--c) 80%, var(--text));
    font-size: var(--step--2);
  }

  .panel {
    display: none;
    gap: var(--space-6);
    padding: var(--space-5);
    border: 1px solid color-mix(in oklab, var(--c) 30%, var(--border));
    border-radius: calc(var(--radius-xl) + 0.25rem);
    background:
      radial-gradient(60% 60% at 100% 0%, color-mix(in oklab, var(--c) 10%, transparent), transparent 70%),
      var(--surface);
  }

  .stepper[data-case='0'] .panel[data-i='0'],
  .stepper[data-case='1'] .panel[data-i='1'],
  .stepper[data-case='2'] .panel[data-i='2'],
  :global(html:not([data-js])) .panel {
    display: grid;
  }

  h3 {
    color: var(--text);
    font-size: var(--step-2);
    letter-spacing: var(--tracking-tight);
  }

  .steps {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 2px solid color-mix(in oklab, var(--c) 50%, var(--border));
  }

  .num {
    color: color-mix(in oklab, var(--c) 80%, var(--text));
    font-size: var(--step--1);
  }

  .steps p {
    color: var(--text-muted);
  }

  .ends {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .end {
    display: grid;
    gap: var(--space-2);
  }

  .end-who {
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .coin {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-weight: 600;
  }

  .coin :global(img) {
    width: 1.75rem;
    height: 1.75rem;
  }

  .outcome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    color: var(--success);
    font-size: var(--step--1);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .panel {
      padding: var(--space-7);
    }

    .tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
