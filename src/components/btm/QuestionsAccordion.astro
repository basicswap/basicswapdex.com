---
// "Questions about this pair" on the Bitcoin to Monero page: numbered
// questions that open in place, the first one open. Answers are our own
// trusted HTML. The FAQPage structured data repeats the same text.
interface Props {
  faq: { q: string; a: string }[];
}
const { faq } = Astro.props;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="acc">
  {
    faq.map(({ q, a }, i) => (
      <details class="item" open={i === 0}>
        <summary>
          <span class="num data">{pad(i)}</span>
          <h3 class="q">{q}</h3>
          <span class="toggle" aria-hidden="true" />
        </summary>
        <p class="a" set:html={a} />
      </details>
    ))
  }
</div>

<style>
  .acc {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .item {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .num {
    color: var(--link);
    font-size: var(--step--1);
  }

  .q {
    color: var(--text);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  summary:hover .q {
    color: var(--link);
  }

  /* a plus that turns into a minus */
  .toggle {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
  }

  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.7rem;
    height: 1.5px;
    translate: -50% -50%;
    background: var(--text-muted);
    transition: rotate var(--dur) var(--ease);
  }

  .toggle::after {
    rotate: 90deg;
  }

  .item[open] .toggle {
    border-color: var(--primary);
  }

  .item[open] .toggle::after {
    rotate: 0deg;
  }

  .a {
    max-width: var(--prose-max);
    padding: 0 3.25rem var(--space-5);
    color: var(--text-muted);
  }

  @media (max-width: 47.99rem) {
    summary {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .num {
      display: none;
    }

    .a {
      padding-inline: 0;
    }
  }
</style>
